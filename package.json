{
  "name": "scum-zonemap",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --base=./",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "tiles": "cd ./ && docker run --rm -v /home:/home ghcr.io/osgeo/gdal:ubuntu-small-latest gdal2tiles.py --processes=16 --xyz --profile=raster --webviewer=leaflet -z 1-8 $PWD/_tempStuff/map.png $PWD/public/assets/t0"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "flowbite": "^1.8.1",
    "flowbite-react": "^0.6.4",
    "formik": "^2.4.5",
    "geojson-validation": "^1.0.2",
    "leaflet": "^1.9.4",
    "leaflet-easybutton": "^2.4.0",
    "leaflet-editable": "^1.2.0",
    "leaflet-shades": "^0.1.4",
    "numeral": "^2.0.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.11.0",
    "store2": "^2.14.2",
    "uuid": "^9.0.1",
    "yup": "^1.3.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "@types/geojson-validation": "^1.0.2",
    "@types/leaflet": "^1.9.7",
    "@types/leaflet-editable": "^1.2.3",
    "@types/node": "^20.8.7",
    "@types/numeral": "^2.0.4",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/uuid": "^9.0.6",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.1.0",
    "@vitejs/plugin-react-swc": "^3.3.2",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "eslint-plugin-tailwindcss": "^3.13.0",
    "postcss": "^8.4.31",
    "postcss-import": "^15.1.0",
    "prettier": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.5.6",
    "sass": "^1.69.4",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  }
}